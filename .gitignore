data/raw/

# Source database and any local copy of it. See the README for where to get it.
*.sqlite
*.sqlite.zip

# NOTE: *.csv is deliberately NOT ignored. The committed CSVs in data/interim/,
# data/external/ and data/processed/ are what make the analysis reproducible
# without the 13 GB source.

